 "narration": [
  {
   "t": 2.6,
   "end": 3.94,
   "text": "Hobby one. Card house."
  },
  {
   "t": 5.35,
   "end": 6.35,
   "text": "Two hours of work."
  },
  {
   "t": 6.65,
   "end": 7.76,
   "text": "Hobby two. Chess."
  },
  {
   "t": 8.22,
   "end": 10.26,
   "text": "His opponent had not even moved yet."
  },
  {
   "t": 13.63,
   "end": 15.21,
   "text": "Checkmate. In zero moves."
  },
  {
   "t": 15.51,
   "end": 17.07,
   "text": "Hobby three. Bird watching."
  },
  {
   "t": 17.37,
   "end": 18.69,
   "text": "Birds do not like noise."
  },
  {
   "t": 24.52,
   "end": 25.86,
   "text": "They found a quieter street."
  },
  {
   "t": 26.16,
   "end": 27.74,
   "text": "Hobby four. Photography."
  },
  {
   "t": 28.04,
   "end": 29.81,
   "text": "The photographer said: hold still."
  },
  {
   "t": 35.08,
   "end": 36.43,
   "text": "This was the sharpest one."
  },
  {
   "t": 36.73,
   "end": 38.37,
   "text": "Hobby five. Model trains."
  },
  {
   "t": 38.67,
   "end": 40.5,
   "text": "The trains ran perfectly on time."
  },
  {
   "t": 45.7,
   "end": 46.96,
   "text": "Next stop: the floor."
  },
  {
   "t": 47.26,
   "end": 48.6,
   "text": "Hobby six. Painting."
  },
  {
   "t": 48.9,
   "end": 50.5,
   "text": "Every landing splashed the paint."
  },
  {
   "t": 57.53,
   "end": 59.07,
   "text": "A museum hung it the next day."
  },
  {
   "t": 59.73,
   "end": 60.8,
   "text": "Finally, a hobby."
  }
